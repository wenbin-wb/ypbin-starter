<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-starter-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-starter-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-starter-core</artifactId>

    <name>${project.artifactId}</name>
    <description>核心基础模块：统一响应、异常体系、通用枚举、常量、Spring 上下文与通用工具</description>

    <dependencies>
        <!-- 提供 @ConfigurationProperties / 自动配置能力，spring-context 等随之引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JSpecify 空值语义注解：本模块以 @NullMarked 声明「未标注即非空」，可空处显式 @Nullable -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- 日志门面（版本由 Spring Boot BOM 管理），作为基础库向下游传递 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 通用工具库 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- Web 相关 API（HttpServletRequest 等），仅编译期可选，不强制引入 servlet 容器 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Actuator 端点支持（可选），宿主引入 actuator 时自动激活 /actuator/ypbin 诊断端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试依赖：JUnit 5 / AssertJ / Spring Boot Test（SpringUtils 集成测试需要容器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          空值语义静态检查试点（默认不激活）：`mvn -Pnullaway -pl ypbin-starter-core compile`
          用 NullAway 把「未标注即非空」的约定变成编译期错误，先在一个模块上量出真实违规量，
          再决定是否逐模块推广。不默认激活的原因：Error Prone 需要一组 add-exports / add-opens
          JVM 参数，且会拖慢编译，先在单个模块验证收益与成本。

          注意 annotationProcessorPaths 是「覆盖」而非「追加」，必须把该模块原有的
          spring-boot-configuration-processor 一并列入，否则配置元数据不再生成、漂移门禁会失败。
        -->
        <profile>
            <id>nullaway</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <!-- 必须 fork：Error Prone 依赖的 javax 导出参数（J 前缀）只对 javac 启动器生效，
                                 非 fork（in-process）模式下会被忽略，并以 IllegalAccessError 崩溃 -->
                            <fork>true</fork>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <!-- fork 模式下 javac 默认的 should-stop 策略为 INIT，Error Prone 不接受，必须显式改为 FLOW -->
                                <arg>--should-stop=ifError=FLOW</arg>
                                <!-- 只跑 NullAway，关闭 Error Prone 其余检查，避免无关告警淹没结论。
                                     整条 -Xplugin 必须写在同一行：换行会被当作独立参数传给 javac。
                                     这里用 AnnotatedPackages 而不是 JSpecifyMode=true：实测本工具链组合
                                     （NullAway 0.11.3 + error_prone_core 2.36.0 + JDK 21 fork javac）下
                                     JSpecifyMode 会让 javac 无任何诊断地失败；AnnotatedPackages 声明同一范围即可，
                                     包上的 @NullMarked 仍保留，供 IDE 与其他 JSpecify 工具识别语义。 -->
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=cn.ypbin.starter.core</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.springframework.boot</groupId>
                                    <artifactId>spring-boot-configuration-processor</artifactId>
                                    <version>${spring-boot.version}</version>
                                </path>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>2.36.0</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>0.11.3</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
