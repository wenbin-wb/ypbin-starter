<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-starter-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-starter-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-starter-messaging</artifactId>

    <name>${project.artifactId}</name>
    <description>消息能力：基于 Spring Mail 的邮件发送封装（文本/HTML/附件）</description>

    <dependencies>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- 短信聚合框架 sms4j：可选，引入并配置对应厂商依赖后启用 -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- WebSocket 实时推送，可选：不用时无需引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- SSE 基于 spring-webmvc 的 SseEmitter，可选（仅 servlet web 应用需要） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- SSE 一次性订阅票据的分布式存储：有 Redis 用 Redis，否则内存。可选依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          SSE 结构化载荷的 JSON 编解码（JacksonSseFanoutCodec，Jackson 3 = tools.jackson.*）：仅当
          宿主容器里存在 ObjectMapper Bean 时自动装配，缺失则退回 TextSseFanoutCodec（行为不变）。
          必须 optional：邮件/短信/MQTT/WebSocket 与纯标量 SSE 扇出都不需要 Jackson，设成强依赖会把
          jackson-databind 强推给每个引入 messaging 的宿主（Boot 4 的 Jackson 3 自动配置位于
          spring-boot-jackson 模块，databind 在其中为 compile 依赖）。本模块自身编译/测试可见，不向宿主传递。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          Flux → SSE 流式桥接（SseStreamBridge）：仅流式响应场景需要，可选依赖。
          必须 optional：本模块绝大多数能力（邮件/短信/MQTT/WebSocket/SSE 扇出）都不需要 Reactor，
          设成强依赖会把 reactor-core 强推给每一个引入 messaging 的宿主（含纯 servlet 应用）。
          版本由 spring-boot-dependencies（4.1.1）经 reactor-bom 统一管理，无需在此声明版本。
        -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          流式桥接的跨线程上下文传播：micrometer context-propagation 的 ContextRegistry 承载各模块
          （如租户的 TenantThreadLocalAccessor）注册的 ThreadLocal 访问器。同样必须 optional：
          它只是「能把租户/用户上下文带过 Reactor 线程切换」的增强，缺席时 SseStreamBridge 退化为
          不传播且不报错（见 SseContextPropagator#micrometerOrNoop 的类存在性守卫）。
          版本由 spring-boot-dependencies（4.1.1）经 micrometer-bom 统一管理，无需在此声明版本。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- MQTT（IoT 场景）：直接用 Paho 客户端，轻量，可选 -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- JSpecify 空值语义注解（Spring Framework 7 起 org.springframework.lang.Nullable 已废弃） -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <jacoco.branch.minimum>0.25</jacoco.branch.minimum>
        <!-- 参与 NullAway 空值语义检查：根包（父 pom 的 nullaway profile 据此限定检查范围） -->
        <nullaway.packages>cn.ypbin.starter.messaging</nullaway.packages>
    </properties>

    <build>
        <plugins>
            <!-- 覆盖率门槛覆盖：messaging 模块含 MQTT/WebSocket/SSE/邮件/短信等重集成组件，
                 门槛 0.30；其余模块沿用 dependencies 统一 0.80 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.30</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
