            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-cloud-sentinel</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-cloud-gateway</artifactId>
