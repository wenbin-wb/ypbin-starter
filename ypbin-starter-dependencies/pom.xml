        <!--
          NullAway 空值语义静态检查（默认关闭，用 -Pnullaway 开启）：
          参与模块只需在自己的 <properties> 里把 nullaway.packages 覆盖为本模块根包，
          并在该根包放一个 @NullMarked 的 package-info.java。
          未覆盖的模块保留下面这个不存在的包名，等价于不做检查。
        -->
        <nullaway.packages>cn.ypbin.starter.__nullaway_placeholder__</nullaway.packages>
        <nullaway.version>0.11.3</nullaway.version>
        <error-prone.version>2.36.0</error-prone.version>
