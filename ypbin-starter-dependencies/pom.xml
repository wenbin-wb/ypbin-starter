              不收敛时最终取谁取决于声明顺序——对宿主就是一个隐式的版本赌博，且 POI 是按 2.21.0 构建的。
              统一钉到 2.21.0（较新者），并由 enforcer 的 dependencyConvergence 规则长期守住。
            -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>

            <!--
              victools jsonschema 版本收敛：Spring AI 2.0（spring-ai-model）按 5.0.0 构建，
