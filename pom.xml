<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.ypbin</groupId>
    <artifactId>ypbin-starter</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>ypbin-starter —— 一套基于 Spring Boot 的开箱即用基础能力 starter 集合</description>
    <url>https://github.com/wenbin-wb/ypbin-starter</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- 发布中央仓库必需元数据：请按实际仓库/作者信息核对修改 -->
    <organization>
        <name>ypbin</name>
        <url>https://github.com/wenbin-wb</url>
    </organization>

    <developers>
        <developer>
            <id>wenbin</id>
            <name>wenbin</name>
            <url>https://github.com/wenbin-wb</url>
            <roles>
                <role>author</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/wenbin-wb/ypbin-starter.git</connection>
        <developerConnection>scm:git:https://github.com/wenbin-wb/ypbin-starter.git</developerConnection>
        <url>https://github.com/wenbin-wb/ypbin-starter</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>ypbin-starter-dependencies</module>
        <module>ypbin-starter-bom</module>
        <module>ypbin-starter-core</module>
        <module>ypbin-starter-json</module>
        <module>ypbin-starter-web</module>
        <module>ypbin-starter-data</module>
        <module>ypbin-starter-cache</module>
        <module>ypbin-starter-security</module>
        <module>ypbin-starter-api-doc</module>
        <module>ypbin-starter-storage</module>
        <module>ypbin-starter-log</module>
        <module>ypbin-starter-tracking</module>
        <module>ypbin-starter-tools</module>
        <module>ypbin-starter-extension-tenant</module>
        <module>ypbin-starter-extension-crud</module>
        <module>ypbin-starter-extension-datapermission</module>
        <module>ypbin-starter-excel</module>
        <module>ypbin-starter-captcha</module>
        <module>ypbin-starter-messaging</module>
        <module>ypbin-starter-sensitive-words</module>
        <module>ypbin-starter-i18n</module>
        <module>ypbin-starter-api-crypto</module>
        <module>ypbin-starter-social</module>
        <module>ypbin-starter-sign</module>
        <module>ypbin-starter-cloud-core</module>
        <module>ypbin-starter-cloud-nacos</module>
        <module>ypbin-starter-cloud-loadbalancer</module>
        <module>ypbin-starter-cloud-observability</module>
        <module>ypbin-starter-cloud-sentinel</module>
        <module>ypbin-starter-cloud-gateway</module>
        <module>ypbin-starter-async</module>
        <module>ypbin-starter-job</module>
        <module>ypbin-starter-xxljob</module>
        <module>ypbin-starter-license</module>
        <module>ypbin-starter-app-web</module>
        <module>ypbin-starter-app-cloud</module>
        <module>ypbin-starter-ai</module>
        <module>ypbin-starter-test</module>
    </modules>

    <properties>
        <revision>3.4.1-SNAPSHOT</revision>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
        <!-- 显式指定 compiler 插件版本：老 Maven（3.8.x）默认 3.1 不支持 <release>，会按 Java 5 编译报错 -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 统一 ${revision} 版本号，install/deploy 时展开为真实版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          非发布的开发/度量模块（架构约束测试、JMH 性能基线）：由 activeByDefault 提供，使默认构建包含它们，
          而 `-Prelease` 激活 release profile 后本 profile 失效 → 这些模块不进入发布反应堆。
          这样它们的空 jar（无签名、无 sources/javadoc）绝不会被 staged 进 Central 上传包。

          ⚠️ 副作用（已实测）：只要激活了根 pom 的任一 profile（如 `-Prelease`，甚至 `-Prelease,it`），
          本 profile 即失效，构建就**不会**执行这里的架构约束测试——`it` 定义在父 pom，不会把模块带回来。
          发布前的铁律门禁由 CI 常规 job（`mvn clean test`）与 tag 流程保证；本地要跑门禁就别加 `-P`，
          或单独执行一次 `mvn -o -pl ypbin-starter-architecture-tests test`。
          新增不发布模块时必须同时加进本 profile 与 sbom profile，并由
          `ModulePublishingTest` 校验（写进顶层 modules 会让未签名产物混进 Central 上传包）。
        -->
        <profile>
            <id>dev-only</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>ypbin-starter-architecture-tests</module>
                <module>ypbin-starter-benchmarks</module>
            </modules>
        </profile>

        <!-- 供应链合规 profile：生成 CycloneDX SBOM（软件物料清单），供下游做依赖审计与漏洞排查。
             运行：mvn -Psbom verify  →  各模块 target/bom.json 与聚合 target/bom.json -->
        <profile>
            <id>sbom</id>
            <!-- 显式带回架构约束测试模块：它是 activeByDefault profile 提供的，
                 任何显式激活的 profile（如本 profile）都会使其失效，故此处补回，
                 保证只有 release 会排除它（SBOM 仍覆盖全部模块）。 -->
            <modules>
                <module>ypbin-starter-architecture-tests</module>
                <module>ypbin-starter-benchmarks</module>
            </modules>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.3</version>
                        <executions>
                            <execution>
                                <id>make-bom</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <projectType>library</projectType>
                            <schemaVersion>1.6</schemaVersion>
                            <includeBomSerialNumber>true</includeBomSerialNumber>
                            <includeCompileScope>true</includeCompileScope>
                            <includeProvidedScope>false</includeProvidedScope>
                            <includeRuntimeScope>true</includeRuntimeScope>
                            <includeTestScope>false</includeTestScope>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 发布 profile：根聚合 pom 无 parent，需自带 GPG 签名与 Central 发布插件
             （两者仅在 deploy 到 Maven Central 时需要；放 profile 内避免普通构建解析失败） -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central Portal 发布插件：根聚合 pom 无 parent 继承不到，需独立声明 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <!-- 纯测试模块不得进入发布包：该模块只设了 maven.deploy.skip=true，
                                 但本插件以 extensions=true 接管 deploy，不读取该属性，会把它的
                                 空 jar 一并打进 bundle——而它 gpg.skip=true 无签名、也没有
                                 sources/javadoc，会让整个 deployment 校验失败。故在此显式排除。 -->
                            <excludeArtifacts>
                                <artifact>ypbin-starter-architecture-tests</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
