<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-starter-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-starter-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-starter-ai</artifactId>
    <name>${project.artifactId}</name>
    <description>AI 基座模块：封装 Spring AI 2.0 ChatClient、RAG、Memory、Tool 等能力</description>

    <dependencies>
        <!-- Spring AI 核心：ChatClient、ChatModel API -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- RAG 管线 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>

        <!-- OpenAI 兼容客户端：支持从模型配置动态构建 ChatModel（不依赖 yml starter） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <!-- 文档解析：PDF -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 文档解析：Markdown / TXT（通用 DocumentReader）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-markdown-document-reader</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 文档解析：docx / xlsx（Apache POI 5.4.x，兼容 JDK21）-->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <!-- 文档解析：html（jsoup 抽取正文文本）-->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>

        <!-- 模型：DeepSeek（首选，V4-Flash/Pro，OpenAI 兼容协议）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 模型：OpenAI（GPT-5.6 系列）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 模型：Ollama（本地部署）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 对话记忆：JDBC 持久化（复用 MySQL）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 向量库：Redis Vector Store（复用已有 Redis）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 向量库：PGVector（可选）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MCP Server（Phase5，暴露 admin 业务工具）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Reactive（Flux 流式响应）-->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- ypbin 内部依赖：Web（R<T>、全局异常）-->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
