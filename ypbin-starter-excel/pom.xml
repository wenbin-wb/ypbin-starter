<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-starter-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-starter-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-starter-excel</artifactId>

    <name>${project.artifactId}</name>
    <description>Excel 导入导出：基于 Apache Fesod 2.0+ 的注解驱动读写与 HTTP 导出封装</description>

    <dependencies>
        <!-- JSpecify 空值语义注解：本模块以 @NullMarked 声明「未标注即非空」 -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-core</artifactId>
        </dependency>
        <!-- CSV 防公式注入导出与下载响应头（Content-Disposition/RFC 5987）统一由 tools 提供：
             Excel 与 CSV 必须共用同一份实现，否则含空格文件名的编码会在两处漂移（issue #98） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tools</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.fesod</groupId>
            <artifactId>fesod-sheet</artifactId>
        </dependency>
        <!-- 导出到 HTTP 响应需要 Servlet API，可选：也支持写入任意 OutputStream -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试用 MockHttpServletResponse 断言下载响应头（BOM 字节 / 内容类型 / RFC 5987 文件名）。
             spring-test 的 MockHttpServletResponse 依赖 spring-web 的 MediaType，故一并声明为 test 作用域 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <jacoco.branch.minimum>0.00</jacoco.branch.minimum>
        <!-- 参与 NullAway 空值语义检查：根包（父 pom 的 nullaway profile 据此限定检查范围） -->
        <nullaway.packages>cn.ypbin.starter.excel</nullaway.packages>
    </properties>

    <build>
        <plugins>
            <!-- 覆盖率门槛覆盖：excel 模块为 Fesod 重集成组件（IO/流式导入导出），单测价值有限，
                 门槛 0.15；其余模块沿用 dependencies 统一 0.80 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.15</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
